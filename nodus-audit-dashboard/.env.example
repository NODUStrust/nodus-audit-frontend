# Example environment variables for NODUS Audit Dashboard
# Copy this file to `.env` and fill in real values for local development.

# Server-side secret used to validate incoming audit submissions (keep this secret)
# Example placeholder (do NOT put a real secret in this committed file)
AUDIT_API_KEY=your_local_api_key

# Optional: If you want logs uploaded to S3 in production, set these.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-audit-bucket-name

# Frontend (public) config — VITE_ prefix makes the variable available to the client.
VITE_API_URL=http://localhost:3000/api

# Development helpers
# Set to 1 during dev to make missing env vars fatal (useful in CI)
FAIL_ON_MISSING_ENV=0
# Example environment variables
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name

AUDIT_API_KEY=your_local_api_key
