# Example .env for Vercel / local
AUDIT_API_KEY=your_audit_api_key_here
PORT=3001
ENVIRONMENT=development
ENV_WARNINGS=true
ENV_ALLOW_MOCK_EMAIL=true
ENV_WATERMARK_TEXT="NODUStrust - DRAFT"
ENV_WATERMARK_ENABLED=true
ENV_PDF_EXPORT_DIR=./docs/exports
ENV_CORS_ALLOWED_ORIGINS=*  # adjust in production
ENV_GIT_COMMIT_MESSAGE_FOR_HANDOFF="Audit sync"
ENV_GITHUB_REPO=https://github.com/NODUStrust/nodus-audit-frontend
ENV_VERCEL_TEAM=
ENV_VERCEL_PROJECT=
ENV_VERCEL_TOKEN=
ENV_VERCEL_AUDIT_API_KEY_SECRET_NAME=AUDIT_API_KEY
ENV_JWT_SECRET=change_this_in_prod
ENV_ADMIN_EMAIL=admin@nodus.trust
ENV_VIEWER_EMAILS=viewer1@nodus.trust,viewer2@nodus.trust
ENV_MOCK_EMAIL_ENABLED=true
ENV_PDF_WATERMARK_OPACITY=0.25
ENV_PDF_WATERMARK_FONTSIZE=14
ENV_PDF_WATERMARK_POSITION=bottom-right
ENV_PDF_WATERMARK_COLOR="#333333"
ENV_PDF_WATERMARK_PREFIX="NODUStrust"
